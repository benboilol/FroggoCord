rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null && request.auth.token.email != null;
    }

    function username() {
      return request.auth.token.email.split('@')[0];
    }

    function isMemberOfServer(serverDoc, uid) {
      return serverDoc.members is list
        && (uid in serverDoc.memberUids || username() in serverDoc.members);
    }

    function isChannelForServer(channel) {
      return channel is string
        && channel.matches('^srv_[A-Za-z0-9_-]+_.*$');
    }

    function serverIdFromChannel(channel) {
      return channel.split('_')[1];
    }

    function isDmChannelForUser(channel) {
      return channel is string
        && channel.matches('^dm_.*$')
        && (
          username() in channel.split('_').slice(1)
        );
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.user == userId
        && request.resource.data.user is string
        && request.resource.data.user.size() > 0
        && request.resource.data.user.size() <= 32;

      allow update: if isAuth()
        && (resource.data.uid == request.auth.uid || !('uid' in resource.data) || resource.data.user == username())
        && request.resource.data.user == resource.data.user
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);

      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    match /presence/{userId} {
      allow read: if isAuth();
      allow write: if isAuth()
        && userId == username()
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
    }

    match /messages/{messageId} {
      allow read: if isAuth();

      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.user == username()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.channel is string
        && (
          (
            isChannelForServer(request.resource.data.channel)
            && exists(/databases/$(database)/documents/servers/$(serverIdFromChannel(request.resource.data.channel)))
            && isMemberOfServer(get(/databases/$(database)/documents/servers/$(serverIdFromChannel(request.resource.data.channel))).data, request.auth.uid)
          )
          ||
          (
            isDmChannelForUser(request.resource.data.channel)
          )
        );

      allow update: if isAuth()
        && (resource.data.uid == request.auth.uid || (!('uid' in resource.data) && resource.data.user == username()))
        && request.resource.data.user == request.resource.data.user
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && (
          (
            resource.data.channel is string
            && isChannelForServer(resource.data.channel)
            && exists(/databases/$(database)/documents/servers/$(serverIdFromChannel(resource.data.channel)))
            && isMemberOfServer(get(/databases/$(database)/documents/servers/$(serverIdFromChannel(resource.data.channel))).data, request.auth.uid)
          )
          ||
          (
            resource.data.channel is string
            && isDmChannelForUser(resource.data.channel)
          )
        )
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);

      allow delete: if isAuth()
        && (resource.data.uid == request.auth.uid || (!('uid' in resource.data) && resource.data.user == username()))
        && (
          (
            resource.data.channel is string
            && isChannelForServer(resource.data.channel)
            && exists(/databases/$(database)/documents/servers/$(serverIdFromChannel(resource.data.channel)))
            && isMemberOfServer(get(/databases/$(database)/documents/servers/$(serverIdFromChannel(resource.data.channel))).data, request.auth.uid)
          )
          ||
          (
            resource.data.channel is string
            && isDmChannelForUser(resource.data.channel)
          )
        );
    }

    match /friends/{friendId} {
      allow read: if isAuth() && (resource.data.from == username() || resource.data.to == username());
      allow create: if isAuth()
        && request.resource.data.from == username()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.from is string
        && request.resource.data.to is string;

      allow update: if isAuth()
        && (resource.data.from == username() || resource.data.to == username())
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to;

      allow delete: if isAuth() && (resource.data.from == username() || resource.data.to == username());
    }

    match /servers/{serverId} {
      allow read: if isAuth()
        && (
          resource.data.members == null
          || username() in resource.data.members
          || (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
        );

      allow create: if isAuth()
        && request.resource.data.owner == username()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 1
        && username() in request.resource.data.members
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.adminUids is list
        && request.auth.uid in request.resource.data.adminUids;

      allow update: if isAuth() && (
        (
          // Owner only: all server state except ownership fields
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 500
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() <= 500
        )
        ||
        (
          // Admins may update settings but not owner/admin/member list/invite
          (
            resource.data.adminUids is list && request.auth.uid in resource.data.adminUids
          ) || (
            resource.data.admins is list && username() in resource.data.admins
          )
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.members == resource.data.members
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.admins == resource.data.admins
          && request.resource.data.adminUids == resource.data.adminUids
        )
        ||
        (
          // Self-join only: a user may append themselves to members, not others
          request.auth.uid != null
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.admins == resource.data.admins
          && request.resource.data.adminUids == resource.data.adminUids
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 500
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() <= 500
          && (
            (
              request.resource.data.members == resource.data.members + [username()]
              && !(username() in resource.data.members)
            )
            ||
            (
              request.resource.data.memberUids == resource.data.memberUids + [request.auth.uid]
              && !(request.auth.uid in resource.data.memberUids)
            )
          )
        )
        ||
        (
          // Self-leave: a non-owner member may remove only themselves from members
          request.auth.uid != null
          && resource.data.owner != username()
          && username() in resource.data.members
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.admins == resource.data.admins
          && request.resource.data.adminUids == resource.data.adminUids
          && request.resource.data.members is list
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !request.resource.data.members.has(username())
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && !(request.auth.uid in request.resource.data.memberUids)
          && request.auth.uid in resource.data.memberUids
        )
      );

      allow delete: if isAuth() && resource.data.ownerUid == request.auth.uid;
    }

    match /typing/{typingId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /reads/{readId} {
      allow read, write: if isAuth();
    }

    // Invites: readable by any authenticated user (for join lookups).
    // Only the server owner can create/delete invite codes.
    match /invites/{inviteCode} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.serverId is string
        && request.resource.data.createdBy == username();
      allow update: if false;
      allow delete: if isAuth() && resource.data.createdBy == username();
    }

    // Blocked: readable/writable only by the blocker.
    match /blocked/{blockId} {
      allow read: if isAuth() && resource.data.blocker == username();
      allow create: if isAuth() && request.resource.data.blocker == username();
      allow delete: if isAuth() && resource.data.blocker == username();
    }
  }
}
