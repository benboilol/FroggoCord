rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null && request.auth.token.email != null;
    }

    function username() {
      return request.auth.token.email.split('@')[0];
    }

    function isOwnerOfServer(data) {
      return data.ownerUid == request.auth.uid || data.owner == username();
    }

    function isAdminOfServer(data) {
      return isOwnerOfServer(data)
        || (data.adminUids is list && request.auth.uid in data.adminUids)
        || (data.admins is list && username() in data.admins);
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.user == userId
        && request.resource.data.user is string
        && request.resource.data.user.size() > 0
        && request.resource.data.user.size() <= 32;

      allow update: if isAuth()
        && (resource.data.uid == request.auth.uid || !('uid' in resource.data) || resource.data.user == username())
        && request.resource.data.user == resource.data.user
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);

      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    match /presence/{userId} {
      allow read: if isAuth();
      allow write: if isAuth()
        && userId == username()
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
    }

    match /messages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.user == username()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.channel is string
        && request.resource.data.channel.size() <= 128;

      allow update: if isAuth()
        && (resource.data.uid == request.auth.uid || (!('uid' in resource.data) && resource.data.user == username()))
        && request.resource.data.user == resource.data.user
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);

      allow delete: if isAuth() && (resource.data.uid == request.auth.uid || (!('uid' in resource.data) && resource.data.user == username()));
    }

    match /friends/{friendId} {
      allow read: if isAuth() && (resource.data.from == username() || resource.data.to == username());
      allow create: if isAuth()
        && request.resource.data.from == username()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.from is string
        && request.resource.data.to is string;

      allow update: if isAuth()
        && (resource.data.from == username() || resource.data.to == username())
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to;

      allow delete: if isAuth() && (resource.data.from == username() || resource.data.to == username());
    }

    match /servers/{serverId} {
      allow read: if isAuth()
        && (
          resource.data.members == null
          || username() in resource.data.members
          || (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
        );

      allow create: if isAuth()
        && request.resource.data.owner == username()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 1
        && username() in request.resource.data.members
        && request.resource.data.memberUids is list
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.adminUids is list
        && request.resource.data.ownerUid in request.resource.data.adminUids == false;

      allow update: if isAuth() && (
        (
          // Owner can change everything except ownership fields.
          resource.data.ownerUid == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 500
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() <= 500
        )
        ||
        (
          // Admins may edit properties but cannot change ownership/admin membership/invite.
          (
            resource.data.adminUids is list && request.auth.uid in resource.data.adminUids
          ) || (
            resource.data.admins is list && username() in resource.data.admins
          )
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.members == resource.data.members
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.admins == resource.data.admins
          && request.resource.data.adminUids == resource.data.adminUids
        )
        ||
        (
          // Self-join only: a user may append themselves to member lists, nothing else.
          request.auth.uid != null
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.admins == resource.data.admins
          && request.resource.data.adminUids == resource.data.adminUids
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 500
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() <= 500
          && (
            (
              request.resource.data.members == resource.data.members + [username()]
              && username() not in resource.data.members
            )
            ||
            (
              request.resource.data.memberUids == resource.data.memberUids + [request.auth.uid]
              && request.auth.uid not in resource.data.memberUids
            )
          )
        )
      );

      allow delete: if isAuth() && resource.data.ownerUid == request.auth.uid;
    }

    match /typing/{typingId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /reads/{readId} {
      allow read, write: if isAuth();
    }
  }
}
